# 大文件走 Git LFS; 高清贴图 (WebP) 等是几 KB 的小文件, 放普通 git (打包推送快得多)
*.gif filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.webp binary
*.png binary
*.wav binary

# ---- 行尾与二进制 (Windows 开发; 只加规则, 仓库内现有文本文件本来就全是 LF, 不需要 renormalize) ----
# 文本文件一律 LF 入库, 工作区也保持 LF (Godot/Python/bash 都认 LF; sh 脚本带 CR 会直接跑不起来)
*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.json text eol=lf
*.evs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
tools/hooks/* text eol=lf
# Windows 批处理/PowerShell 需要 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# 二进制: 不转换、不合并、不做文本 diff
*.gz binary
*.7z binary
*.zip binary
*.ogv binary
*.ogg binary
*.exe binary
*.ico binary
*.ttf binary
*.otf binary
*.GSF binary
