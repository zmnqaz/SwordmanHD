# 编辑器统一设置 (VS Code / JetBrains / Godot 外部编辑器等); 注意 .gd 用 Tab 缩进
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gd]
indent_style = tab

[*.{py,sh,yml,yaml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,evs}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
